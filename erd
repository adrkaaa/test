CREATE TABLE ПОЛЬЗОВАТЕЛЬ (
    id_пользователя PK,
    логин,
    фамилия,
    имя,
    отчество,
    роль
);

CREATE TABLE КАТЕГОРИЯ (
    id_категории PK,
    название
);

CREATE TABLE ПОДКАТЕГОРИЯ (
    id_подкатегории PK,
    id_категории FK,
    название
);

CREATE TABLE ПРОИЗВОДИТЕЛЬ (
    id_производителя PK,
    название
);

CREATE TABLE ТОВАР (
    id_товара PK,
    id_подкатегории FK,
    id_производителя FK,
    наименование,
    изображение,
    состав,
    описание,
    цена
);

CREATE TABLE РАЗМЕР_ТОВАРА (
    id_размера_товара PK,
    id_товара FK,
    размер,
    количество
);

CREATE TABLE ЗАКАЗ (
    id_заказа PK,
    id_пользователя FK,
    дата_заказа,
    итоговая_сумма
);

CREATE TABLE СОСТАВ_ЗАКАЗА (
    id_позиции_заказа PK,
    id_заказа FK,
    id_размера_товара FK,
    количество,
    цена
);
